<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= strip_html(page.description || config.description || '') %>">
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <%- open_graph({twitter_card:'summary'}) %>
  <script>try{let t=localStorage.getItem('breeze-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}</script>
  <link rel="stylesheet" href="<%= url_for('/css/site.css') %>">
  <% if (theme.rss) { %><link rel="alternate" type="application/atom+xml" title="RSS" href="<%= url_for(theme.rss) %>"><% } %>
  <script defer src="<%= url_for('/js/site.js') %>"></script>
</head>
<body data-search-index="<%= url_for('/search-index.json') %>">
<a class="skip" href="#main">跳到正文</a>
<header><a class="brand" href="<%= url_for('/') %>"><%= config.title %></a><nav aria-label="主导航">
<% [['首页','/'],['归档','/'+config.archive_dir+'/'],['分类','/'+config.category_dir+'/'],['标签','/'+config.tag_dir+'/'],['搜索','/search/']].forEach(([label,path])=> { %><a href="<%= url_for(path) %>" <% if (url_for(page.path || '') === url_for(path) || url_for(page.path || '') === url_for(path+'index.html')) { %>aria-current="page"<% } %>><%= label %></a><% }); %>
<button class="theme" type="button">跟随系统</button></nav></header>
<main id="main" class="<%= is_post() ? 'post-layout' : '' %>"><%- body %></main>
<footer><p>© <%= theme.copyright_start ? theme.copyright_start+'–' : '' %><%= date(Date.now(),'YYYY') %> <%= config.author %></p><p><% if(theme.beian){ %><a href="https://beian.miit.gov.cn/"><%= theme.beian %></a> · <% } %><% if(theme.rss){ %><a href="<%= url_for(theme.rss) %>">RSS</a> · <% } %><a href="https://github.com/NightingaleWK/hexo-theme-breezehome">Breezehome</a></p></footer>
</body></html>
