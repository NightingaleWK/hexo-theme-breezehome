<% const content = page.content || ''; %>
<% const hasMermaid = /data-bh-mermaid/.test(content); %>
<% const hasMath = /class="(?:bh-math-block|katex)/.test(content); %>
<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= strip_html(page.description || config.description || '') %>">
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <% if (theme.favicon) { %><link rel="icon" href="<%= url_for(theme.favicon) %>"><% } %>
  <%- open_graph({twitter_card:'summary'}) %>
  <script>try{let t=localStorage.getItem('breeze-theme');document.documentElement.dataset.theme=t==='light'||t==='dark'?t:matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'}</script>
  <link rel="stylesheet" href="<%= url_for('/css/site.css') %>">
  <% if (page.layout === 'home' && theme.home_stylesheet) { %><link rel="stylesheet" href="<%= url_for(theme.home_stylesheet) %>"><% } %>
  <% if (page.stylesheet && /^\/(?!\/)/.test(page.stylesheet)) { %><link rel="stylesheet" href="<%= url_for(page.stylesheet) %>"><% } %>
  <% if (hasMath) { %><link rel="stylesheet" href="<%= url_for('/css/vendor/katex/katex.min.css') %>"><% } %>
  <% if (theme.rss) { %><link rel="alternate" type="application/atom+xml" title="RSS" href="<%= url_for(theme.rss) %>"><% } %>
  <% if (hasMermaid) { %><script defer src="<%= url_for('/js/vendor/mermaid.min.js') %>"></script><script defer src="<%= url_for('/js/mermaid.js') %>"></script><% } %>
  <script defer src="<%= url_for('/js/site.js') %>"></script>
</head>
<body id="top" data-search-index="<%= url_for('/search-index.json') %>">
<a class="skip" href="#main">跳到正文</a>
<header>
<a class="brand" href="<%= url_for('/') %>"><% if (theme.logo) { %><img class="brand-logo" src="<%= url_for(theme.logo) %>" alt="" width="32" height="32"><% } %><span><%= config.title %></span></a>
<details class="site-nav">
<summary aria-label="菜单">
<svg class="nav-icon nav-icon-menu" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
<svg class="nav-icon nav-icon-close" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
</summary>
<nav aria-label="主导航">
<% bh_navigation().forEach(({label,url:path})=> { %><a href="<%= url_for(path) %>" <% if (url_for(page.path || '') === url_for(path) || url_for(page.path || '') === url_for(path+'index.html')) { %>aria-current="page"<% } %>><%= label %></a><% }); %>
</nav>
</details>
<button class="theme" type="button" data-mode="system" aria-label="当前跟随系统，点击切换浅色" title="当前：跟随系统；点击切换浅色">
<svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M12 16v4m-4 0h8"/></svg>
<svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
<svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13.2A9 9 0 0 1 10.8 3.1a9 9 0 1 0 10.1 10.1Z"/></svg>
</button>
</header>
<main id="main" tabindex="-1" class="<%= is_post() ? 'post-layout' : '' %>"><%- body %></main>
<footer><p>© <%= theme.copyright_start ? theme.copyright_start+'–' : '' %><%= date(Date.now(),'YYYY') %> <%= config.author %></p><p><% if(theme.beian){ %><a href="<%= theme.beian_url || 'https://beian.miit.gov.cn/' %>"><%= theme.beian %></a> · <% } %><% if(theme.rss){ %><a href="<%= url_for(theme.rss) %>">RSS</a> · <% } %><a href="https://github.com/NightingaleWK/hexo-theme-breezehome">Breezehome</a></p></footer>
<a class="back-to-top" href="#top" aria-label="回到顶部" title="回到顶部"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14M12 20V8m-6 6 6-6 6 6"/></svg></a>
</body></html>
